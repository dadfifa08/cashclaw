# Cateo backend runtime secrets and operator auth
OPENAI_API_KEY=sk-your-openai-key

# Optional site bridge settings
# CATEO_INTERNAL_TOKEN=replace-with-strong-random-token
# CATEO_BACKEND_URL=http://127.0.0.1:3777

# Optional: protect the local command center with operator credentials.
# Format: username:role:password entries separated by semicolons.
# Roles: admin, reviewer, analyst, viewer
CATEO_OPERATOR_USERS=admin:admin:ChangeMeNow123!

# Simpler single-admin alternative
# CATEO_OPERATOR_ADMIN_PASSWORD=ChangeMeNow123!
